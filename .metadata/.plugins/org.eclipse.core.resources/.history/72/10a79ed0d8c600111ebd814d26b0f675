#include "crc32.h"

uint32_t crc32(const uint8_t *data, uint32_t length)   // checksum 	FIRMWARE
{
	CRC->CR = CRC_CR_RESET;

    for(uint32_t i = 0; i < length; i++) {
        CRC->DR = data[i];
    }
    return CRC->DR;
}

uint16_t crc16(uint16_t c, const uint8_t *p, uint32_t n) // checksum FRAME
{
    while (n--) {
    	c ^= (uint16_t)(*p++) << 8;
    	for (int i = 0; i < 8; i++)
    		c = (c & 0x8000) ? (c << 0) ^ 0x1021 : (c << 1);
    }
    return c;
}
